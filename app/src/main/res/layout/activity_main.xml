<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MI PANINI"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"/>

    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mundial 2026"
        android:textColor="#D4AF37"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnMiPanini"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="MI PANINI"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#000000"
        android:backgroundTint="#D4AF37"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp"
        android:layout_marginHorizontal="32dp"/>

    <Button
        android:id="@+id/btnFaltantes"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="FALTANTES"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#000000"
        android:backgroundTint="#D4AF37"
        app:layout_constraintTop_toBottomOf="@id/btnMiPanini"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="32dp"/>

    <Button
        android:id="@+id/btnMiUsuario"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="MI USUARIO"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#000000"
        android:backgroundTint="#D4AF37"
        app:layout_constraintTop_toBottomOf="@id/btnFaltantes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>